---
/** Contact page: direct channels, the contact form and the FAQ. Docs: docs/features/contact-form.md, docs/features/contact-channels.md */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { useT } from '../../i18n';
import { CONTACT, LINKS } from '../../config/site';
import { localeStaticPaths, type Locale } from '../../lib/paths';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const c = t.contact;

const channels: { id: string; icon: IconName; label: string; value: string; href: string; external: boolean }[] = [
  { id: 'email', icon: 'mail', label: 'Email', value: CONTACT.email, href: LINKS.email, external: false },
  { id: 'phone', icon: 'phone', label: c.phoneLabel, value: c.phone, href: LINKS.phone, external: false },
  { id: 'zalo', icon: 'chat', label: 'Zalo', value: c.zalo, href: LINKS.zalo, external: true },
  { id: 'whatsapp', icon: 'chat', label: 'WhatsApp', value: c.whatsapp, href: LINKS.whatsapp, external: true },
  { id: 'messenger', icon: 'chat', label: 'Messenger', value: c.messenger, href: LINKS.messenger, external: true },
  { id: 'community', icon: 'people', label: c.communityLabel, value: c.community, href: LINKS.community, external: true },
];
---

<BaseLayout lang={lang} title={t.meta.contactTitle} description={t.meta.contactDescription} showCta={false}>
  <section class="container contact">
    <div class="intro">
      <h1 class="h1">{c.title}</h1>
      <p class="lead">{c.sub}</p>
      <ul class="channels">
        {
          channels.map((ch) => (
            <li>
              <a
                class="channel"
                href={ch.href}
                data-channel={ch.id}
                target={ch.external ? '_blank' : undefined}
                rel={ch.external ? 'noopener noreferrer' : undefined}
              >
                <Icon name={ch.icon} size={22} strokeWidth={1.7} />
                <span class="text">
                  <span class="label">{ch.label}</span>
                  <span class="value">{ch.value}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <ContactForm lang={lang} />
  </section>

  <section class="band" id="faq">
    <div class="container section">
      <div class="section-head">
        <div>
          <h2 class="h2">{t.faq.title}</h2>
          <p class="lead">{t.faq.more}</p>
        </div>
        <a class="text-link" href={LINKS.community} target="_blank" rel="noopener noreferrer" data-faq-community>
          {t.faq.join}<Icon name="arrow-up-right" size={18} strokeWidth={2} />
          <span class="visually-hidden">{t.common.opensNewTab}</span>
        </a>
      </div>
      <div class="faq">
        {
          t.faq.items.map((item) => (
            <div class="qa">
              <h3>{item.q}</h3>
              <p class="muted">{item.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 56px;
    padding-block: 80px 96px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .channels {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 12px 0 0;
    list-style: none;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 8px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    transition: border-color 0.2s ease-out;
  }
  .channel:hover {
    border-color: var(--ink);
  }
  .channel :global(svg) {
    color: var(--ink);
    flex-shrink: 0;
  }
  .text {
    display: flex;
    flex-direction: column;
  }
  .label {
    font-weight: 600;
    font-size: 15px;
  }
  .value {
    font-size: 14px;
    color: var(--text-2);
  }
  .faq {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    gap: 20px 40px;
  }
  .qa {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }
  .qa h3 {
    font-size: 18px;
  }
  .qa p {
    font-size: 15px;
    line-height: 1.6;
  }
  @media (max-width: 420px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
