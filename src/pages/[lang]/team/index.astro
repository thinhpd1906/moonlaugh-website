---
/** Team list. Docs: docs/features/team-profiles.md */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import TeamCard from '../../../components/TeamCard.astro';
import { useT } from '../../../i18n';
import { localeStaticPaths, type Locale } from '../../../lib/paths';
import { publishedMembers } from '../../../data/team';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
---

<BaseLayout lang={lang} title={t.meta.teamTitle} description={t.meta.teamDescription}>
  <PageHeader title={t.team.title} sub={t.team.sub} />
  <section class="container grid-wrap">
    <div class="team-grid">
      {publishedMembers().map((m) => <TeamCard lang={lang} member={m} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .grid-wrap {
    padding-bottom: 96px;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }
</style>
