---
/** Home page. Docs: docs/features/home.md */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TeamCard from '../../components/TeamCard.astro';
import { useT } from '../../i18n';
import { localePath, localeStaticPaths, type Locale } from '../../lib/paths';
import { publishedMembers } from '../../data/team';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const members = publishedMembers();
const chips = ['iOS & Android', 'AI', 'Web', 'TV & Streaming', 'BA', 'Data Science'];
---

<BaseLayout lang={lang} title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <!-- Hero -->
  <section class="container hero">
    <div class="hero-copy">
      <h1>{t.hero.title}</h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={localePath(lang, 'contact')} data-cta="hero">{t.hero.cta1}</a>
        <button type="button" class="btn btn-ghost" data-open-chat>
          <Icon name="chat" />
          <span>{t.hero.cta2}</span>
        </button>
      </div>
      <p class="hero-note">{t.hero.note}</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="ring ring-1"></div>
      <div class="ring ring-2"></div>
      <svg class="moon" viewBox="0 0 100 100">
        <path d="M14 48 A36 36 0 0 0 86 48 A46 46 0 0 1 14 48 Z" fill="var(--accent)"></path>
        <circle cx="76" cy="18" r="3" fill="var(--accent)"></circle>
        <circle cx="24" cy="22" r="1.6" fill="var(--text-2)"></circle>
        <circle cx="52" cy="10" r="1.2" fill="var(--text-2)"></circle>
      </svg>
      {chips.map((chip, i) => <span class={`pill chip chip-${i}`}>{chip}</span>)}
    </div>
  </section>

  <!-- Services -->
  <section class="band">
    <div class="container section">
      <div class="section-head">
        <div>
          <h2 class="h2">{t.services.title}</h2>
          <p class="lead">{t.services.sub}</p>
        </div>
        <a class="text-link" href={localePath(lang, 'services')}>{t.more.services}<Icon name="arrow-right" size={18} strokeWidth={2} /></a>
      </div>
      <ul class="service-list">
        {
          t.services.items.map((s) => (
            <li>
              <a class="service-row" href={`${localePath(lang, 'services')}#${s.key}`} data-service={s.key}>
                <h3>{s.title}</h3>
                <p class="muted">{s.text}</p>
                <span class="service-meta">
                  <span>{s.tags}</span>
                  <Icon name="arrow-right" size={22} strokeWidth={2} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="ask">
        <p><strong>{t.services.ask.title}</strong> {t.services.ask.text}</p>
        <a class="text-link" href={localePath(lang, 'contact')}>{t.services.ask.btn}<Icon name="arrow-right" size={18} strokeWidth={2} /></a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="container section">
    <div class="section-head">
      <div><h2 class="h2">{t.process.title}</h2></div>
      <a class="text-link" href={localePath(lang, 'process')}>{t.more.process}<Icon name="arrow-right" size={18} strokeWidth={2} /></a>
    </div>
    <ol class="steps">
      {
        t.process.steps.map((step, i) => (
          <li>
            <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Why -->
  <section class="band">
    <div class="container section">
      <div class="section-head"><div><h2 class="h2">{t.why.title}</h2></div></div>
      <div class="why">
        {
          t.why.items.map((w) => (
            <div>
              <h3>{w.title}</h3>
              <p class="muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team preview -->
  <section class="container section">
    <div class="section-head">
      <div><h2 class="h2">{t.team.title}</h2></div>
      <a class="text-link" href={localePath(lang, 'team')}>{t.more.team}<Icon name="arrow-right" size={18} strokeWidth={2} /></a>
    </div>
    <div class="team-grid">
      {members.map((m) => <TeamCard lang={lang} member={m} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 48px;
    align-items: center;
    padding-block: 88px 72px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .hero-sub {
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 560px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  .hero-note {
    font-size: 14px;
    color: var(--muted);
  }
  .hero-art {
    position: relative;
    width: min(100%, 480px);
    aspect-ratio: 1 / 1;
    justify-self: center;
  }
  .ring {
    position: absolute;
    border-radius: 50%;
  }
  .ring-1 {
    inset: 0;
    border: 1px solid var(--line);
  }
  .ring-2 {
    inset: 14%;
    border: 1px solid var(--border);
  }
  .moon {
    position: absolute;
    inset: 22%;
    width: 56%;
    height: 56%;
  }
  .chip {
    position: absolute;
    font-weight: 600;
  }
  .chip-0 { left: 2%; top: 26%; }
  .chip-1 { right: 4%; top: 18%; }
  .chip-2 { right: 0; bottom: 30%; }
  .chip-3 { left: 10%; bottom: 14%; }
  .chip-4 { left: 44%; bottom: 2%; }
  .chip-5 { left: 6%; top: 6%; }

  .service-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .service-list li {
    border-bottom: 1px solid var(--border);
    padding-block: 6px;
  }
  .service-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px 40px;
    align-items: center;
    padding: 22px 16px;
    border-radius: 12px;
    transition: background-color 0.2s ease-out;
  }
  .service-row:hover {
    background: var(--surface);
  }
  .service-row h3 {
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .service-row p {
    font-size: 16px;
    line-height: 1.6;
  }
  .service-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
    color: var(--muted);
  }
  .service-meta :global(svg) {
    color: var(--ink);
    flex-shrink: 0;
  }
  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 24px 16px 0;
  }
  .ask p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 720px;
  }
  .ask strong {
    color: var(--text);
    font-weight: 600;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 2px solid var(--accent);
    padding-top: 20px;
  }
  .step-n {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }
  .steps h3 {
    font-size: 19px;
  }
  .steps p,
  .why p {
    font-size: 15px;
    line-height: 1.6;
  }

  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }
  .why > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--border-2);
    padding-top: 20px;
  }
  .why h3 {
    font-size: 20px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }
</style>
